# Server
PORT=3000
NODE_ENV=production

# Data source (JSON file for now – later switch repository to Supabase)
PAPERS_PATH=./src/data/papers.json

# Pagination
DEFAULT_LIMIT=20
MAX_LIMIT=100

# CORS – comma-separated origins, leave empty to allow all
# Example: https://geleza.ai,https://app.geleza.ai,capacitor://localhost
CORS_ORIGINS=
