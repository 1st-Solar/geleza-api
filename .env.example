# Server
PORT=3000
NODE_ENV=production
APP_VERSION=1.0.0

# Data source
PAPERS_PATH=./src/data/papers.json

# Pagination
DEFAULT_LIMIT=20
MAX_LIMIT=100

# CORS – comma-separated origins (empty = allow all, Capacitor-friendly)
# Example: https://geleza.ai,capacitor://localhost,http://localhost:5173
CORS_ORIGINS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
